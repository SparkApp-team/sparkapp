#!/bin/sh

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"

if [ -z "$branch" ]; then
  exit 0
fi

branch_regex='^(main|dependabot/.+|release/v[0-9]+(\.[0-9]+){1,2}|(feature|fix|chore|docs|test|refactor|spike|ci|deps)/(backend|ios|api|db|auth|repo|infra|docs)/([0-9]+-)?[a-z0-9]+(-[a-z0-9]+)*)$'

if printf '%s\n' "$branch" | grep -Eq "$branch_regex"; then
  exit 0
fi

cat >&2 <<'EOF'
Invalid branch name.

Expected:
  <type>/<area>/<optional-issue-number>-<short-kebab-description>

Allowed types:
  feature, fix, chore, docs, test, refactor, spike, ci, deps

Allowed areas:
  backend, ios, api, db, auth, repo, infra, docs

Valid examples:
  feature/backend/12-create-habit-endpoint
  feature/ios/13-habit-list-screen
  docs/api/14-habit-contract
  fix/backend/18-streak-timezone-bug
  refactor/backend/habit-service
  chore/repo/github-templates
  ci/backend/maven-build
  deps/backend/spring-boot-upgrade
  spike/auth/session-strategy
  test/backend/habit-service-tests

Also allowed:
  main
  dependabot/*
  release/v1.2 or release/v1.2.3
EOF

exit 1
