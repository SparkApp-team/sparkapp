@baseUrl = http://localhost:8081
@userId = 1
@otherUserId = 2
@habitId = 1
@missingHabitId = 999999
@zeroHabitId = 0
@negativeHabitId = -1

### Health check
GET {{baseUrl}}/health

### Register first user
# Expected: 200 OK
# Response contains id 1 on a fresh database.
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "roman@example.com",
  "password": "password",
  "passwordConfirmation": "password"
}

### Register second user
# Expected: 200 OK
# Response contains id 2 on a fresh database.
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "second@example.com",
  "password": "password123",
  "passwordConfirmation": "password123"
}

### Register duplicate email
# Expected: 409 Conflict
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "roman@example.com",
  "password": "password",
  "passwordConfirmation": "password"
}

### Register missing email
# Expected: 400 Bad Request
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "",
  "password": "password",
  "passwordConfirmation": "password"
}

### Register missing password
# Expected: 400 Bad Request
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "missing-password@example.com",
  "password": "",
  "passwordConfirmation": ""
}

### Register short password
# Expected: 400 Bad Request
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "short-password@example.com",
  "password": "short",
  "passwordConfirmation": "short"
}

### Register missing password confirmation
# Expected: 400 Bad Request
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "missing-confirmation@example.com",
  "password": "password",
  "passwordConfirmation": ""
}

### Register mismatched passwords
# Expected: 400 Bad Request
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "mismatch@example.com",
  "password": "password",
  "passwordConfirmation": "different-password"
}

### Login first user
# Expected: 200 OK
# Use returned id as X-USER-ID while fake auth is in place.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "roman@example.com",
  "password": "password"
}

### Login second user
# Expected: 200 OK
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "second@example.com",
  "password": "password123"
}

### Login wrong password
# Expected: 401 Unauthorized
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "roman@example.com",
  "password": "wrong-password"
}

### Login unknown email
# Expected: 401 Unauthorized
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "unknown@example.com",
  "password": "password"
}

### Login missing email
# Expected: 400 Bad Request
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "",
  "password": "password"
}

### Login missing password
# Expected: 400 Bad Request
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "roman@example.com",
  "password": ""
}

### Get current user
# Expected: 200 OK for userId 1 on a fresh database.
GET {{baseUrl}}/users/me
X-USER-ID: {{userId}}

### Get second current user
# Expected: 200 OK for userId 2 on a fresh database.
GET {{baseUrl}}/users/me
X-USER-ID: {{otherUserId}}

### Get current user without fake auth header
# Expected: 400 Bad Request because X-USER-ID is required.
GET {{baseUrl}}/users/me

### Get current user with invalid fake auth header
# Expected: 500 Internal Server Error unless fake auth error handling is added.
GET {{baseUrl}}/users/me
X-USER-ID: not-a-number

### Update current user
# Expected: 200 OK with roman.updated@example.com.
PATCH {{baseUrl}}/users/me
Content-Type: application/json
X-USER-ID: {{userId}}

{
  "email": "roman.updated@example.com"
}

### Update current user with invalid email
# Expected: 400 Bad Request with fieldErrors.email set to "Email must be valid".
PATCH {{baseUrl}}/users/me
Content-Type: application/json
X-USER-ID: {{userId}}

{
  "email": "not-an-email"
}

### Update current user with blank email
# Expected: 400 Bad Request with fieldErrors.email set to "Email is required".
PATCH {{baseUrl}}/users/me
Content-Type: application/json
X-USER-ID: {{userId}}

{
  "email": ""
}

### Update current user with another user's email
# Expected: 409 Conflict because second@example.com belongs to user 2.
PATCH {{baseUrl}}/users/me
Content-Type: application/json
X-USER-ID: {{userId}}

{
  "email": "second@example.com"
}

### Create habit for first user
# Expected: 201 Created
POST {{baseUrl}}/habits
Content-Type: application/json
X-USER-ID: {{userId}}

{
  "name": "Drink water",
  "frequency": "daily"
}

### Create another habit for first user
# Expected: 201 Created
POST {{baseUrl}}/habits
Content-Type: application/json
X-USER-ID: {{userId}}

{
  "name": "Read",
  "frequency": "weekly"
}

### Create habit for second user
# Expected: 201 Created
POST {{baseUrl}}/habits
Content-Type: application/json
X-USER-ID: {{otherUserId}}

{
  "name": "Walk",
  "frequency": "daily"
}

### List habits for first user
# Expected: only habits created with X-USER-ID 1.
GET {{baseUrl}}/habits
X-USER-ID: {{userId}}

### List habits for second user
# Expected: only habits created with X-USER-ID 2.
GET {{baseUrl}}/habits
X-USER-ID: {{otherUserId}}

### List habits without fake auth header
# Expected: 400 Bad Request because X-USER-ID is required.
GET {{baseUrl}}/habits

### List habits with invalid fake auth header
# Expected: 500 Internal Server Error unless fake auth error handling is added.
GET {{baseUrl}}/habits
X-USER-ID: not-a-number

### Get habit by ID
# Expected: 200 OK when habit 1 belongs to user 1.
GET {{baseUrl}}/habits/{{habitId}}
X-USER-ID: {{userId}}

### Get another user's habit
# Expected: 404 Not Found because ownership is checked.
GET {{baseUrl}}/habits/{{habitId}}
X-USER-ID: {{otherUserId}}

### Get missing habit
# Expected: 404 Not Found.
GET {{baseUrl}}/habits/{{missingHabitId}}
X-USER-ID: {{userId}}

### Get habit with zero ID
# Expected: 400 Bad Request with fieldErrors.habitId set to "must be greater than 0".
GET {{baseUrl}}/habits/{{zeroHabitId}}
X-USER-ID: {{userId}}

### Update habit
# Expected: 200 OK when habit 1 belongs to user 1.
PUT {{baseUrl}}/habits/{{habitId}}
Content-Type: application/json
X-USER-ID: {{userId}}

{
  "name": "Drink more water",
  "frequency": "twice daily"
}

### Update another user's habit
# Expected: 404 Not Found because ownership is checked.
PUT {{baseUrl}}/habits/{{habitId}}
Content-Type: application/json
X-USER-ID: {{otherUserId}}

{
  "name": "Changed by another user",
  "frequency": "weekly"
}

### Update habit with invalid request
# Expected: 400 Bad Request because name and frequency are required.
PUT {{baseUrl}}/habits/{{habitId}}
Content-Type: application/json
X-USER-ID: {{userId}}

{
  "name": "",
  "frequency": ""
}

### Update habit with negative ID
# Expected: 400 Bad Request with fieldErrors.habitId set to "must be greater than 0".
PUT {{baseUrl}}/habits/{{negativeHabitId}}
Content-Type: application/json
X-USER-ID: {{userId}}

{
  "name": "Exercise",
  "frequency": "weekly"
}

### Delete another user's habit
# Expected: 404 Not Found because ownership is checked.
DELETE {{baseUrl}}/habits/{{habitId}}
X-USER-ID: {{otherUserId}}

### Delete habit with zero ID
# Expected: 400 Bad Request with fieldErrors.habitId set to "must be greater than 0".
DELETE {{baseUrl}}/habits/{{zeroHabitId}}
X-USER-ID: {{userId}}

### Delete habit
# Expected: 204 No Content when habit 1 belongs to user 1.
DELETE {{baseUrl}}/habits/{{habitId}}
X-USER-ID: {{userId}}

### Get deleted habit
# Expected: 404 Not Found after the delete request above.
GET {{baseUrl}}/habits/{{habitId}}
X-USER-ID: {{userId}}

### Delete current user
# Expected: 204 No Content. Also deletes the user's remaining habits.
DELETE {{baseUrl}}/users/me
X-USER-ID: {{userId}}

### Get deleted current user
# Expected: 404 Not Found after deleting the user above.
GET {{baseUrl}}/users/me
X-USER-ID: {{userId}}

### List deleted user's habits
# Expected: 200 OK with an empty list, confirming associated habits were deleted.
GET {{baseUrl}}/habits
X-USER-ID: {{userId}}
