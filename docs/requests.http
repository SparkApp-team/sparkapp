@baseUrl = http://localhost:8081
@userId = 1
@otherUserId = 2

### Health check
GET {{baseUrl}}/health

### Register first user
# Expected: 200 OK
# Response contains userId "1" on a fresh database.
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "roman@example.com",
  "password": "password"
}

### Register second user
# Expected: 200 OK
# Response contains userId "2" on a fresh database.
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "second@example.com",
  "password": "password123"
}

### Register duplicate email
# Expected: 409 Conflict
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "roman@example.com",
  "password": "password"
}

### Register missing email
# Expected: 400 Bad Request
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "",
  "password": "password"
}

### Register missing password
# Expected: 400 Bad Request
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "missing-password@example.com",
  "password": ""
}

### Register short password
# Expected: 400 Bad Request
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "short-password@example.com",
  "password": "short"
}

### Login first user
# Expected: 200 OK
# Use returned userId as X-USER-ID while fake auth is in place.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "roman@example.com",
  "password": "password"
}

### Login second user
# Expected: 200 OK
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "second@example.com",
  "password": "password123"
}

### Login wrong password
# Expected: 401 Unauthorized
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "roman@example.com",
  "password": "wrong-password"
}

### Login unknown email
# Expected: 401 Unauthorized
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "unknown@example.com",
  "password": "password"
}

### Login missing email
# Expected: 400 Bad Request
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "",
  "password": "password"
}

### Login missing password
# Expected: 400 Bad Request
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "roman@example.com",
  "password": ""
}

### Get current user
# Expected: 200 OK for userId 1 on a fresh database.
GET {{baseUrl}}/users/me
X-USER-ID: {{userId}}

### Get second current user
# Expected: 200 OK for userId 2 on a fresh database.
GET {{baseUrl}}/users/me
X-USER-ID: {{otherUserId}}

### Get current user without fake auth header
# Expected: 400 Bad Request because X-USER-ID is required.
GET {{baseUrl}}/users/me

### Get current user with invalid fake auth header
# Expected: 500 Internal Server Error unless fake auth error handling is added.
GET {{baseUrl}}/users/me
X-USER-ID: not-a-number

### Create habit for first user
# Expected: 200 OK
POST {{baseUrl}}/habits
Content-Type: application/json
X-USER-ID: {{userId}}

{
  "name": "Drink water",
  "frequency": "daily"
}

### Create another habit for first user
# Expected: 200 OK
POST {{baseUrl}}/habits
Content-Type: application/json
X-USER-ID: {{userId}}

{
  "name": "Read",
  "frequency": "weekly"
}

### Create habit for second user
# Expected: 200 OK
POST {{baseUrl}}/habits
Content-Type: application/json
X-USER-ID: {{otherUserId}}

{
  "name": "Walk",
  "frequency": "daily"
}

### List habits for first user
# Expected: only habits created with X-USER-ID 1.
GET {{baseUrl}}/habits
X-USER-ID: {{userId}}

### List habits for second user
# Expected: only habits created with X-USER-ID 2.
GET {{baseUrl}}/habits
X-USER-ID: {{otherUserId}}

### List habits without fake auth header
# Expected: 400 Bad Request because X-USER-ID is required.
GET {{baseUrl}}/habits

### List habits with invalid fake auth header
# Expected: 500 Internal Server Error unless fake auth error handling is added.
GET {{baseUrl}}/habits
X-USER-ID: not-a-number
